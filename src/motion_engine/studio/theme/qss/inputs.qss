QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {{
    background: transparent;
    border: none;
    border-bottom: 1px solid {border_strong};
    border-radius: {radius_sm}px;
    padding: 8px 0 10px 0;
    selection-background-color: {selection_fill};
    selection-color: {text_primary};
    color: {text_primary};
}}
QLineEdit:hover, QComboBox:hover {{
    border-bottom-color: {text_muted};
    background: {hover};
}}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {{
    border: none;
    border-bottom: 1px solid {accent};
    background: transparent;
}}
QLineEdit:disabled, QComboBox:disabled {{
    color: {text_disabled};
}}
QLineEdit#SearchField {{
    border-radius: {radius_md}px;
    background: {surface_sunken};
    border: 1px solid {border};
    border-bottom: 1px solid {border};
    padding: 8px 12px;
    color: {text_primary};
}}
QLineEdit#SearchField:focus {{
    border: 1px solid {accent};
    background: {surface};
}}
QComboBox::drop-down {{
    border: none;
    width: 20px;
}}
QComboBox QAbstractItemView {{
    background: {surface};
    border: 1px solid {border};
    border-radius: {radius_md}px;
    selection-background-color: {selection_fill};
    selection-color: {text_primary};
    padding: {space_xs}px;
    outline: none;
}}
QSlider::groove:horizontal {{
    height: 4px;
    background: {border};
    border-radius: 2px;
}}
QSlider::sub-page:horizontal {{
    background: {accent};
    border-radius: 2px;
}}
QSlider::handle:horizontal {{
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
    background: {accent};
    border: none;
}}
QSlider::handle:horizontal:hover {{
    background: {accent_hover};
}}
/* Rounded scrub track + larger playhead with hover glow */
QSlider#TimelineScrubber {{
    min-height: 20px;
    max-height: 20px;
    padding: 0px;
    margin: 0px;
    background: transparent;
    border: none;
}}
QSlider#TimelineScrubber::groove:horizontal {{
    height: 4px;
    margin: 8px 0;
    background: {border};
    border: none;
    border-radius: 2px;
}}
QSlider#TimelineScrubber::sub-page:horizontal {{
    height: 4px;
    background: {accent};
    margin: 8px 0;
    border: none;
    border-radius: 2px;
}}
QSlider#TimelineScrubber::add-page:horizontal {{
    height: 4px;
    background: transparent;
    margin: 8px 0;
    border: none;
}}
QSlider#TimelineScrubber::handle:horizontal {{
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
    background: {accent};
    border: 2px solid {surface};
}}
QSlider#TimelineScrubber::handle:horizontal:hover {{
    background: {accent_hover};
    width: 16px;
    height: 16px;
    margin: -6px 0;
}}
QSlider#TimelineScrubber::handle:horizontal:pressed {{
    background: {accent_pressed};
}}
/* Overlay scrollbars — thin, rounded, no buttons */
QScrollBar:vertical {{
    background: transparent;
    width: 4px;
    margin: 4px 2px 4px 0;
    border: none;
}}
QScrollBar::handle:vertical {{
    background: rgba(28, 30, 35, 0.28);
    border-radius: 2px;
    min-height: 32px;
}}
QScrollBar::handle:vertical:hover {{
    background: rgba(28, 30, 35, 0.45);
}}
QScrollBar::handle:vertical:pressed {{
    background: rgba(28, 30, 35, 0.60);
}}
QScrollBar:horizontal {{
    background: transparent;
    height: 4px;
    margin: 0 4px 2px 4px;
    border: none;
}}
QScrollBar::handle:horizontal {{
    background: rgba(28, 30, 35, 0.28);
    border-radius: 2px;
    min-width: 32px;
}}
QScrollBar::handle:horizontal:hover {{
    background: rgba(28, 30, 35, 0.45);
}}
QScrollBar::handle:horizontal:pressed {{
    background: rgba(28, 30, 35, 0.60);
}}
QScrollBar::add-line, QScrollBar::sub-line {{
    height: 0;
    width: 0;
    border: none;
    background: none;
}}
QScrollBar::add-page, QScrollBar::sub-page {{
    background: none;
}}
QProgressBar {{
    background: {surface_sunken};
    border: none;
    border-radius: 2px;
    text-align: center;
    color: {text_secondary};
    min-height: 4px;
}}
QProgressBar::chunk {{
    background: {accent};
    border-radius: 2px;
}}
QCheckBox, QRadioButton {{
    spacing: {space_sm}px;
    color: {text_secondary};
    font-weight: 500;
}}
QCheckBox::indicator, QRadioButton::indicator {{
    width: 14px;
    height: 14px;
    border: 1px solid {border_strong};
    background: transparent;
}}
QCheckBox::indicator {{ border-radius: {radius_sm}px; }}
QRadioButton::indicator {{ border-radius: 7px; }}
QCheckBox::indicator:checked, QRadioButton::indicator:checked {{
    background: {accent};
    border-color: {accent};
}}
QCheckBox::indicator:hover {{
    border-color: {accent};
}}
