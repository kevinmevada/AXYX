* {{
    font-family: {font_family};
    font-size: {size_md}px;
    color: {text_primary};
    outline: none;
}}
QMainWindow, QDialog {{
    background-color: {background};
    color: {text_primary};
}}
/* Do NOT make every QWidget transparent — Fusion then paints OS dark Window
   into dock holes and the Explorer rail goes solid black while Workspace
   (which sets an explicit fill) stays Museum White. */
QWidget {{
    color: {text_primary};
}}
QWidget#Workspace,
QWidget#WelcomeRoot,
QWidget#StageRoot,
QWidget#CommandBar,
QWidget#TimelineDock,
QWidget#CentralRoot {{
    background-color: {background};
    border: none;
}}
QMainWindow {{
    background-color: {background};
    border: none;
}}
QGroupBox {{
    background: transparent;
    border: none;
    border-top: 1px solid {border_subtle};
    border-radius: 0px;
    margin-top: {space_lg}px;
    padding: {space_md}px 0;
    font-weight: 600;
    color: {text_primary};
}}
QGroupBox::title {{
    subcontrol-origin: margin;
    left: 0;
    padding: 0;
    color: {text_disabled};
    font-size: {size_xs}px;
    letter-spacing: {tracking_caps};
    text-transform: uppercase;
}}
QLabel#BrandTitle {{
    font-family: {font_family};
    font-size: 14px;
    font-weight: 600;
    background: transparent;
}}
QLabel#BrandSubtitle {{
    font-family: {font_family};
    font-size: {size_xs}px;
    font-weight: 600;
    letter-spacing: {tracking_caps};
    text-transform: uppercase;
    color: {text_muted};
}}
QLabel#MutedLabel {{
    color: {text_primary};
    font-size: {size_lg}px;
    font-weight: 400;
}}
QLabel#SectionLabel {{
    color: {text_secondary};
    font-size: {size_xs}px;
    font-weight: 600;
    letter-spacing: {tracking_caps};
    text-transform: uppercase;
    padding-top: 0;
}}
QLabel#WelcomeBrand {{
    background: transparent;
    border: none;
}}
QLabel#WelcomeTagline {{
    background: transparent;
    color: {text_primary};
}}
QLabel#WelcomeSupport {{
    background: transparent;
    color: {text_secondary};
}}
QLabel#WelcomeFoot {{
    background: transparent;
    color: {text_muted};
}}
QLabel#HeroTitle {{
    font-family: {font_family_display};
    font-size: {size_display}px;
    font-weight: 600;
    background: transparent;
}}
QLabel#FeatureHeading {{
    font-weight: 600;
    font-size: {size_sm}px;
    color: {text_primary};
}}
QLabel#FeatureBody {{
    font-size: {size_lg}px;
    font-weight: 400;
    color: {text_secondary};
}}
QLabel#MetricValue {{
    font-family: {font_family_mono};
    font-size: {size_xl}px;
    font-weight: 600;
    color: {text_primary};
}}
QLabel#MetricUnit {{
    font-size: {size_xs}px;
    color: {text_muted};
}}
QLabel#EyebrowLabel {{
    color: {text_muted};
    font-size: {size_xs}px;
    font-weight: 600;
    letter-spacing: {tracking_caps};
    text-transform: uppercase;
}}
QLabel#ErrorBannerText {{
    color: {danger};
    font-size: {size_sm}px;
    font-weight: 600;
}}
QLabel#EmptyTitle {{
    font-size: {size_md}px;
    font-weight: 600;
    color: {text_primary};
}}
QLabel#EmptySubtitle {{
    font-size: {size_lg}px;
    font-weight: 400;
    color: {text_secondary};
}}
QLabel#TimecodeLabel {{
    font-family: {font_family_mono};
    font-size: {size_sm}px;
    color: {text_secondary};
    letter-spacing: 0.2px;
}}
QLabel#FrameLabel {{
    font-family: {font_family_mono};
    font-size: {size_sm}px;
    font-weight: 500;
    color: {text_primary};
    letter-spacing: 0.2px;
}}
QWidget#ViewportStage {{
    background-color: {viewport_void};
}}
QSplitter::handle {{
    background: transparent;
    width: {space_sm}px;
}}
QToolTip {{
    background: {surface};
    color: {text_primary};
    border: 1px solid {border};
    border-radius: {radius_md}px;
    padding: 8px 12px;
    font-size: {size_sm}px;
}}
