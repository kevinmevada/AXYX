QPushButton {{
    background: transparent;
    border: none;
    border-radius: {radius_md}px;
    padding: 8px 12px;
    font-weight: 500;
    color: {text_secondary};
}}
QPushButton:hover {{
    color: {text_primary};
    background: {hover};
}}
QPushButton:pressed {{
    color: {text_primary};
    background: {surface_sunken};
}}
QPushButton:disabled {{
    color: {text_disabled};
}}
QPushButton:focus {{
    border: none;
}}
QPushButton#PrimaryButton {{
    background: {accent};
    /* Fusion needs a real border to clip fills to border-radius on Windows. */
    border: 1px solid {accent};
    color: {text_on_accent};
    border-radius: {radius_cta}px;
    padding: 14px 32px;
    min-height: 52px;
    font-size: {size_md}px;
    font-weight: 600;
    letter-spacing: 0.2px;
}}
QPushButton#PrimaryButton:hover {{
    background: {accent_hover};
    border: 1px solid {accent_hover};
    color: {text_on_accent};
}}
QPushButton#PrimaryButton:pressed {{
    background: {accent_pressed};
    border: 1px solid {accent_pressed};
    color: {text_on_accent};
}}
QPushButton#PrimaryButton:disabled {{
    background: {accent_muted};
    border: 1px solid {accent_muted};
    color: {text_secondary};
}}
/* Top-bar chrome — one 12px / 32px baseline for camera + viz + display */
QPushButton#SegmentButton {{
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    border-radius: {radius_sm}px;
    padding: 0 10px;
    margin: 0;
    font-family: {font_family};
    font-weight: 600;
    font-size: {size_sm}px;
    letter-spacing: 0.2px;
    min-width: 56px;
    min-height: 32px;
    max-height: 32px;
    color: {text_muted};
}}
QPushButton#SegmentButton:checked {{
    background: transparent;
    color: {text_primary};
    border-bottom: 2px solid {accent};
}}
QPushButton#SegmentButton:hover:!checked {{
    background: {hover};
    color: {text_secondary};
}}
QPushButton#GhostButton {{
    background: transparent;
    border: none;
    border-radius: {radius_md}px;
    color: {text_secondary};
    font-family: {font_family};
    font-size: {size_sm}px;
    font-weight: 500;
    letter-spacing: 0.2px;
    min-height: 32px;
    max-height: 32px;
    padding: 0 10px;
}}
QPushButton#GhostButton:hover {{
    color: {text_primary};
    background: {hover};
}}
QToolButton {{
    background: transparent;
    border: none;
    border-radius: {radius_md}px;
    padding: 4px;
    font-family: {font_family};
    font-weight: 500;
    color: {text_secondary};
}}
QToolButton:hover {{
    color: {text_primary};
    background: {hover};
}}
QToolButton:checked {{
    color: {text_primary};
    background: {selection_fill};
}}
QToolButton:pressed {{
    color: {text_primary};
    background: {surface_sunken};
}}
QToolButton:focus {{
    border: none;
}}
QToolButton#TransportButton,
QToolButton#StopTransportButton,
QToolButton#PlayTransportButton {{
    border-radius: {radius_md}px;
    padding: 0;
    margin: 0;
    min-width: 48px;
    min-height: 48px;
    max-width: 48px;
    max-height: 48px;
    background: transparent;
    border: none;
}}
QToolButton#TransportButton:hover,
QToolButton#StopTransportButton:hover,
QToolButton#PlayTransportButton:hover {{
    background: {hover};
    border: none;
    color: {text_primary};
}}
QToolButton#TransportButton:pressed,
QToolButton#StopTransportButton:pressed,
QToolButton#PlayTransportButton:pressed {{
    background: {surface_sunken};
    border: none;
    color: {accent};
}}
QToolButton#TransportButton:focus,
QToolButton#StopTransportButton:focus,
QToolButton#PlayTransportButton:focus {{
    background: transparent;
    border: none;
    outline: none;
}}
QToolButton#LoopButton {{
    min-height: 32px;
    max-height: 32px;
    padding: 0 12px;
    border-radius: {radius_pill}px;
    background: transparent;
    border: none;
    font-family: {font_family};
    font-size: {size_sm}px;
    font-weight: 500;
    color: {text_muted};
}}
QToolButton#LoopButton:hover {{
    color: {text_secondary};
    background: {hover};
}}
QToolButton#LoopButton:checked {{
    background: {selection_fill};
    color: {accent};
    border: none;
}}
QComboBox#SpeedPill,
QComboBox#CompactSpeed {{
    min-height: 32px;
    max-height: 32px;
    padding: 0 28px 0 12px;
    font-family: {font_family};
    font-size: {size_sm}px;
    font-weight: 500;
    border-radius: {radius_pill}px;
    border: 1px solid {border};
    background: {surface_sunken};
    color: {text_secondary};
}}
QComboBox#SpeedPill:hover,
QComboBox#CompactSpeed:hover {{
    background: {hover};
    border-color: {border_strong};
    color: {text_primary};
}}
QComboBox#SpeedPill:focus,
QComboBox#CompactSpeed:focus {{
    border: 1px solid {accent};
    background: {selection_fill};
    color: {accent};
}}
/* Explorer section ▾ / ▸ — must stay 20×20 (never share TopChrome metrics) */
QToolButton#SectionChevron {{
    background: transparent;
    border: none;
    border-radius: {radius_sm}px;
    padding: 0;
    margin: 0;
    min-width: 20px;
    max-width: 20px;
    min-height: 20px;
    max-height: 20px;
    color: {text_secondary};
}}
QToolButton#SectionChevron:hover {{
    background: {hover};
    color: {text_primary};
}}
QToolButton#SectionChevron:checked {{
    background: transparent;
    color: {text_primary};
}}
QToolButton#SectionChevron::menu-indicator {{
    image: none;
    width: 0;
}}
/* Top-bar text controls only */
QToolButton#ExplorerSwitch,
QToolButton#TopChrome {{
    background: transparent;
    border: none;
    border-radius: {radius_md}px;
    padding: 0 10px;
    margin: 0;
    min-height: 32px;
    max-height: 32px;
    font-family: {font_family};
    font-size: {size_sm}px;
    font-weight: 500;
    letter-spacing: 0.2px;
    color: {text_secondary};
}}
QToolButton#ExplorerSwitch:hover,
QToolButton#TopChrome:hover {{
    color: {text_primary};
    background: {hover};
}}
QToolButton#ExplorerSwitch:checked,
QToolButton#TopChrome:checked {{
    background: {selection_fill};
    border: none;
    color: {text_primary};
}}
QToolButton#TopChrome::menu-indicator {{
    image: none;
    width: 0;
    height: 0;
}}
