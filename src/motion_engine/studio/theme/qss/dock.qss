QWidget#CommandBar {{
    background: {background};
    border: none;
    border-bottom: 1px solid {border_subtle};
    min-height: 56px;
    max-height: 56px;
}}
QWidget#TimelineDock {{
    background: {background};
    border: none;
    border-top: 1px solid {border};
    border-radius: 0px;
}}
QAbstractButton#PlayPauseButton {{
    background: transparent;
    border: none;
}}
QWidget#ViewportToolbar {{
    background: transparent;
    border: none;
    border-radius: 0px;
    padding: 0;
    min-height: 32px;
    max-height: 32px;
}}
QWidget#ChromeHost {{
    background: transparent;
    min-height: 32px;
    max-height: 32px;
}}
QFrame#ToolbarDivider {{
    background-color: transparent;
    max-width: 0px;
    min-width: 0px;
    border: none;
}}
QDockWidget#ExplorerDock {{
    margin: 0px;
    border: none;
    background: {background};
    color: {text_primary};
}}
QDockWidget#ExplorerDock > QWidget {{
    background: {background};
    border: none;
}}
QFrame#Sidebar,
QFrame#InspectorPanel,
QFrame#ExplorerPanel,
QFrame#TimelinePanel,
QFrame#ViewportPanel,
QFrame#FloatingPanel {{
    background-color: {background};
    background: {background};
    border: none;
    border-radius: 0px;
    margin: 0px;
}}
QFrame#Sidebar QWidget {{
    background-color: transparent;
    color: {text_primary};
}}
QFrame#Sidebar QListWidget,
QFrame#Sidebar QLineEdit {{
    background-color: {background};
    color: {text_primary};
}}
QFrame#CenterPanel {{
    background-color: {background};
    border: none;
}}
QFrame#Card,
QFrame#InspectorCard {{
    background: transparent;
    border: none;
    border-radius: 0px;
}}
QFrame#Divider {{
    background-color: {divider};
    max-height: 1px;
    min-height: 1px;
    border: none;
}}
QFrame#ErrorBanner {{
    background-color: {danger_muted};
    border: none;
    border-left: 2px solid {danger};
    border-radius: 0px;
}}
QFrame#EmptyState {{
    background: transparent;
    border: none;
    border-radius: 0px;
    min-height: 100px;
}}
QToolBar {{
    background: transparent;
    border: none;
    spacing: {space_sm}px;
    padding: {space_xs}px {space_sm}px;
}}
QDockWidget {{
    color: {text_primary};
    background: {background};
    border: none;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}}
QDockWidget > QWidget {{
    background: {background};
}}
QDockWidget::title {{
    background: {background};
    color: {text_disabled};
    border: none;
    padding: 0;
    font-weight: 600;
    font-size: {size_xs}px;
    letter-spacing: {tracking_caps};
    text-transform: uppercase;
    text-align: left;
}}
QDockWidget::close-button, QDockWidget::float-button {{
    background: transparent;
    border: none;
}}
QMainWindow::separator {{
    background: {border_subtle};
    width: 1px;
    height: 1px;
}}
QMainWindow QTabBar::tab {{
    background: transparent;
    color: {text_disabled};
    border: none;
    border-bottom: 2px solid transparent;
    padding: {space_sm}px {space_lg}px;
    margin: 0;
    min-width: 72px;
    font-weight: 600;
    font-size: {size_sm}px;
}}
QMainWindow QTabBar::tab:selected {{
    color: {text_primary};
    background: transparent;
    border-bottom: 2px solid {accent};
}}
QMainWindow QTabBar::tab:hover:!selected {{
    color: {text_primary};
}}
