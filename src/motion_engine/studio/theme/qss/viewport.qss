QWidget#LoadingOverlay {{
    background-color: {overlay_scrim};
}}
QFrame#LoadingCard {{
    background-color: {surface};
    border: 1px solid {border};
    border-radius: 16px;
}}
QLabel#LoadingBrand {{
    font-family: {font_family_display};
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.3px;
    background: transparent;
}}
QLabel#LoadingTitle {{
    font-family: {font_family};
    font-size: {size_md}px;
    font-weight: 600;
    color: {text_primary};
}}
QLabel#LoadingStage {{
    font-family: {font_family};
    font-size: {size_sm}px;
    font-weight: 400;
    color: {text_primary};
}}
QLabel#LoadingDoneRow {{
    font-family: {font_family};
    font-size: {size_xs}px;
    font-weight: 500;
    color: {text_secondary};
}}
QProgressBar#LoadingBar {{
    background: {surface_sunken};
    border: none;
    border-radius: 3px;
    min-height: 5px;
    max-height: 5px;
}}
QProgressBar#LoadingBar::chunk {{
    background: {accent};
    border-radius: 3px;
}}
QLabel#LoadingPercent {{
    font-family: {font_family_mono};
    font-size: {size_sm}px;
    font-weight: 500;
    color: {text_primary};
    letter-spacing: 0.2px;
}}
QLabel#LoadingMeta {{
    font-family: {font_family};
    font-size: {size_xs}px;
    font-weight: 400;
    color: {text_secondary};
}}
QFrame#WelcomeOpening {{
    background: transparent;
    border: none;
}}
QLabel#WelcomeOpeningLabel {{
    font-family: {font_family};
    font-size: {size_sm}px;
    font-weight: 600;
    color: {accent};
}}
QProgressBar#WelcomeOpeningBar {{
    background: {surface_sunken};
    border: none;
    border-radius: 3px;
    min-height: 5px;
    max-height: 5px;
}}
QProgressBar#WelcomeOpeningBar::chunk {{
    background: {accent};
    border-radius: 3px;
}}
QWidget#ViewportStage {{
    background-color: {viewport_void};
    border: none;
    border-radius: 0px;
}}
